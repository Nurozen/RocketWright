{
  "version": 1,
  "source": "artifacts/research/concepts.md §2 (dark studio style tokens). `value` is the spec value; `accept` holds the §2 pixel samples plus exemplar samples recorded by `pnpm -C app bar:calibrate` (marked in `use`).",
  "tolerance": { "deltaE2000": 3 },
  "colors": {
    "bg/canvas": {
      "value": "#1b1e20",
      "accept": ["#1d2226", "#181e21"],
      "use": "App background (header, left rail, agent pane, history strip): warm charcoal with a slight green-grey cast. §2 samples: #1d2226 header, #181e21 chat."
    },
    "bg/viewport-top": {
      "value": "#22282c",
      "accept": [],
      "use": "Top of the soft vertical vignette behind the 3D model. No grid on the Assembly page."
    },
    "bg/viewport-bottom": {
      "value": "#171c20",
      "accept": [],
      "use": "Bottom of the viewport vignette."
    },
    "panel": {
      "value": "#25292c",
      "accept": ["#21262a", "#242a2f"],
      "use": "Inspector, toolbar, and editor surfaces. §2 samples: #21262a inspector, #242a2f toolbar."
    },
    "line": {
      "value": "#2a3034",
      "accept": ["#32383e", "#3a4248"],
      "use": "1 px hairline dividers between all panes. #32383e (01) and #3a4248 (02): exemplar hairline medians (calibrated)."
    },
    "text/primary": {
      "value": "#e6e9ea",
      "accept": [],
      "use": "Off-white primary text."
    },
    "text/secondary": {
      "value": "#8e989c",
      "accept": [],
      "use": "Labels, timestamps, units."
    },
    "accent/teal": {
      "value": "#61b5ad",
      "accept": ["#4ecdcf", "#64c3c1", "#70e2e2", "#72f4f6"],
      "use": "Selection, active tab underline, links, run series A. §2 rendered range #4ecdcf to #64c3c1; #70e2e2 and #72f4f6: exemplar tab underlines and series-A legend (calibrated)."
    },
    "accent/teal-fill": {
      "value": "#134b4b",
      "accept": ["#133f42", "#0f6b6f"],
      "use": "Primary buttons: deep teal fill, teal 1 px border, white text. §2: #134b4b Check model, #133f42 Run selected, #0f6b6f Review inputs."
    },
    "selection/row": {
      "value": "#283f41",
      "accept": ["#1e3237", "#26464a"],
      "use": "Selected row: teal-tinted background with a teal left/edge border. §2: #283f41 tree, #1e3237 table row A; #26464a: 05 rail row (calibrated)."
    },
    "bubble/user": {
      "value": "#253c3f",
      "accept": [],
      "use": "User message bubble, teal-tinted, radius 6 px."
    },
    "series-b": {
      "value": "#f1ae6e",
      "accept": [],
      "use": "Second compared run (sand/orange): plot series, colour dots, run chips."
    },
    "series-b/row": {
      "value": "#302d28",
      "accept": [],
      "use": "Row tint of the selected series-B run, with an amber border."
    },
    "amber/ghost": {
      "value": "#e8a94a",
      "accept": [],
      "use": "Dashed previous-geometry outline (02) and the Tank B connector (05)."
    },
    "warning": {
      "value": "#fac95e",
      "accept": [],
      "use": "Warning dot or triangle: Modified, Outdated, Missing inputs."
    },
    "success": {
      "value": "#61b5ad",
      "accept": ["#4ecdcf", "#64c3c1"],
      "use": "Complete / done checks are teal, never green."
    },
    "parachute": {
      "value": "#e8732a",
      "accept": [],
      "use": "Parachute material: the only saturated hue in a model. Render material; judged by critics (no probe)."
    },
    "fluid": {
      "value": "#26555c",
      "accept": [],
      "use": "Translucent cool-teal fluid body (06) with soft white streamlines. Render material; judged by critics (no probe)."
    }
  },
  "typography": {
    "family": ["Inter", "SF Pro Text", "system-ui"],
    "tabularNumbers": true,
    "monospace": false,
    "roles": {
      "body": { "selector": "[data-testid=\"agent.reply\"]", "embed": "[data-message-role=\"assistant\"] [data-thread-find-text]", "px": [12.5, 14], "pages": "*" },
      "secondary": { "selector": "[data-testid=\"rail.thread-age\"]", "px": [11, 12.5], "pages": "*" },
