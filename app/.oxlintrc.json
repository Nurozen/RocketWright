{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": { "browser": true, "node": true, "es2024": true },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "packages/rw-wasm/pkg/**", "packages/contracts/src/generated/**"],
  "rules": {
    "eslint/no-debugger": "error",
    "eslint/no-console": "off",
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-var": "error",
    "eslint/prefer-const": ["error", { "destructuring": "all" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "react/jsx-key": "error",
    "react/react-in-jsx-scope": "off",
    "react-hooks/exhaustive-deps": "off",
    "react/refs": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/memo-dependencies": "off",
    "react/set-state-in-effect": "off",
    "react/use-memo": "off",
    "react/immutability": "off",
    "react/preserve-manual-memoization": "off",
    "eslint/no-await-in-loop": "off",
    "eslint/no-underscore-dangle": "off",
    "eslint/no-shadow": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/consistent-function-scoping": "off",
    "oxc/no-map-spread": "off",
    "import/no-unassigned-import": "off",
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    "vitest/no-conditional-expect": "off",
    "vitest/require-to-throw-message": "off",
    "vitest/no-standalone-expect": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/prefer-add-event-listener": "off",
    "eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }]
  }
}
