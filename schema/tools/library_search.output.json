{
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LibItem"
      }
    },
    "total": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "description": "Every item matching the search, before `offset` and `limit`."
    },
    "facets": {
      "$ref": "#/$defs/LibraryFacets"
    }
  },
  "required": [
    "items",
    "total",
    "facets"
  ],
  "title": "LibrarySearchOut",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketwright.dev/schema/1/tools/library_search.output.json",
  "$defs": {
    "LibItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Library ref, e.g. `preset:bt-55` or `lib:components/fin_can.rw.toml`."
        },
        "kind": {
          "$ref": "#/$defs/LibKind"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "Origin and license, e.g. `openrocket-database (Apache-2.0)`."
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "description": "Source-form fields (units as strings)."
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "source",
        "data"
      ]
    },
    "LibKind": {
      "type": "string",
      "enum": [
        "component",
        "material",
        "preset",
        "motor"
      ]
    },
    "LibraryFacets": {
      "type": "object",
      "properties": {
        "manufacturers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FacetCount"
          }
        },
        "component_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FacetCount"
          }
        }
      },
      "required": [
        "manufacturers",
        "component_types"
      ],
      "description": "The values a search can narrow by. Each facet ignores its own filter, so\nchoosing a manufacturer still lists the others."
    },
    "FacetCount": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "value",
        "count"
      ],
      "description": "One facet value and how many matching items carry it."
    }
  }
}
