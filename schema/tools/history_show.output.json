{
  "type": "object",
  "properties": {
    "step": {
      "$ref": "#/$defs/HistoryStep"
    },
    "diff": {
      "$ref": "#/$defs/ModelDiff",
      "description": "Diff against the previous step."
    }
  },
  "required": [
    "step",
    "diff"
  ],
  "title": "HistoryShowOut",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketwright.dev/schema/1/tools/history_show.output.json",
  "$defs": {
    "HistoryStep": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "1-based sequence number (`step:<seq>`, shown as `Step 04`)."
        },
        "id": {
          "type": "string",
          "description": "Commit id in `.rw/history.git`.",
          "pattern": "^[0-9a-f]{40}$"
        },
        "prev": {
          "type": [
            "string",
            "null"
          ]
        },
        "ts": {
          "type": "string",
          "description": "RFC 3339 time (from `RW_CLOCK` when set)."
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "thread": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tool or CLI command that caused the step."
        },
        "tool_call": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "description": "Short human title, e.g. `Exploded assembly`."
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileChange"
          }
        },
        "model_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "metrics": {
          "$ref": "#/$defs/StepMetrics"
        },
        "rev": {
          "type": [
            "string",
            "null"
          ],
          "description": "Revision tagged at this step, e.g. `rev:07`."
        }
      },
      "required": [
        "seq",
        "id",
        "ts",
        "origin",
        "title",
        "files",
        "model_hash",
        "metrics"
      ],
      "description": "One recorded step: a snapshot-tree change (D3) in `.rw/history.git`."
    },
    "Origin": {
      "type": "string",
      "enum": [
        "cli",
        "mcp",
        "socket",
        "watcher",
        "ui"
      ],
      "description": "Where a command came from."
    },
    "FileChange": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/FileStatus"
        }
      },
      "required": [
        "path",
        "status"
      ]
    },
    "FileStatus": {
      "type": "string",
      "enum": [
        "A",
        "M",
        "D"
      ]
    },
    "StepMetrics": {
      "type": "object",
      "properties": {
        "stability_liftoff": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "mass_liftoff": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "x-unit-dimension": "mass"
        },
        "apogee_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "description": "Metrics stored per step so the history strip can draw sparklines without\nre-evaluating."
    },
    "ModelDiff": {
      "type": "object",
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Added component ids."
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldChange"
          }
        }
      },
      "required": [
        "a",
        "b",
        "added",
        "removed",
        "changed"
      ],
      "description": "Semantic model diff keyed by component id."
    },
    "FieldChange": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "Source pointer, e.g. `/c/fins/span`."
        },
        "old": true,
        "new": true,
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "SI unit of the field (`m`, `kg/m^3`) when a side is a quantity\nliteral (`\"70 mm\"`); `old_si`/`new_si` are those sides in that unit."
        },
        "old_si": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "new_si": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "component",
        "path"
      ]
    }
  }
}
