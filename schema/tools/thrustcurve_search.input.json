{
  "type": "object",
  "properties": {
    "query": {
      "type": [
        "string",
        "null"
      ],
      "description": "Designation or common name (`C6`, `H128W`); a leading word may name\nthe manufacturer (`Estes C6`). A delay suffix (`C6-5`) is ignored."
    },
    "manufacturer": {
      "type": [
        "string",
        "null"
      ],
      "description": "Manufacturer name or abbreviation (`Estes`, `AeroTech`)."
    },
    "diameter": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\s*(=.+|[-+]?[0-9.][0-9.eE+/ -]*\\s*[^\\s0-9.].*)$"
            },
            {
              "const": 0
            }
          ],
          "x-unit-dimension": "length",
          "x-expr": true
        },
        {
          "type": "null"
        }
      ],
      "description": "Motor diameter, e.g. `\"18 mm\"`."
    },
    "impulse_class": {
      "type": [
        "string",
        "null"
      ],
      "description": "Impulse class letter (`C`).",
      "pattern": "^(1/8A|1/4A|1/2A|[A-Oa-o])$"
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 1,
      "description": "Most motors to return (default 20, at most 100).",
      "maximum": 100
    }
  },
  "description": "Search thrustcurve.org's motor database. The only network access in\nRocketWright, and only when the user asks for it.",
  "title": "ThrustcurveSearchIn",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketwright.dev/schema/1/tools/thrustcurve_search.input.json"
}
