{
  "type": "object",
  "properties": {
    "motors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MotorInfo"
      }
    }
  },
  "required": [
    "motors"
  ],
  "title": "MotorSearchOut",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketwright.dev/schema/1/tools/motor_search.output.json",
  "$defs": {
    "MotorInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Motor ref usable in a config, e.g. `generic:RW_C6G`."
        },
        "designation": {
          "type": "string"
        },
        "manufacturer": {
          "type": [
            "string",
            "null"
          ]
        },
        "class": {
          "type": "string"
        },
        "diameter": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "length"
        },
        "length": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "length"
        },
        "total_impulse": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "impulse"
        },
        "burn_time": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "time"
        },
        "average_thrust": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "force"
        },
        "delays": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "x-unit-dimension": "time"
        },
        "total_mass": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "mass"
        },
        "source": {
          "$ref": "#/$defs/MotorSource"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "designation",
        "class",
        "diameter",
        "length",
        "total_impulse",
        "burn_time",
        "average_thrust",
        "delays",
        "total_mass",
        "source",
        "sha256"
      ]
    },
    "MotorSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "generic"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "description": "Built-in RocketWright generic curve (`lib/motors/generic/`), e.g. `RW_C6G`."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "library"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "description": "A project `lib/motors/` file with its recorded sha256."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "embedded"
            },
            "origin": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "origin"
          ],
          "description": "Embedded in an imported file (e.g. an `.rse` inside an `.ork`)."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "thrustcurve"
            },
            "motor_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "motor_id"
          ],
          "description": "ThrustCurve.org download in the gitignored cache (parity only)."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "liquid"
            },
            "engine": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "engine"
          ],
          "description": "Generated by a liquid engine design (`engines/<id>.rw.toml`)."
        }
      ],
      "description": "Where a curve came from (motor provenance; never OR-DB curves, S:31)."
    }
  }
}
