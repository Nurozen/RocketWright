{
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      }
    }
  },
  "required": [
    "ok",
    "files",
    "diagnostics"
  ],
  "title": "ValidateOut",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketwright.dev/schema/1/tools/project_validate.output.json",
  "$defs": {
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Stable code, e.g. `RW-E021`.",
          "pattern": "^RW-[EWI][0-9]{3}$"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "JSON pointer into the source model, e.g. `/c/fins/span`."
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "description": "Project-relative file."
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "col": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ],
          "description": "Next action for an agent."
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "description": "One finding, phrased for an agent (`hint` says what to do next)."
    },
    "Severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    }
  }
}
