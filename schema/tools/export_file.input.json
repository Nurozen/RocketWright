{
  "type": "object",
  "properties": {
    "format": {
      "$ref": "#/$defs/ExportFormat"
    },
    "path": {
      "type": "string",
      "description": "Output path, project-relative (or absolute inside the project)."
    },
    "config": {
      "type": [
        "string",
        "null"
      ]
    },
    "run": {
      "type": [
        "string",
        "null"
      ],
      "description": "Run ref (CSV export)."
    },
    "allow_outside": {
      "type": "boolean",
      "description": "Reserved for the person's own export: `rw export --allow-outside` and\nthe app's File > Export. Refused on an agent's call."
    }
  },
  "required": [
    "format",
    "path"
  ],
  "title": "ExportFileIn",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketwright.dev/schema/1/tools/export_file.input.json",
  "$defs": {
    "ExportFormat": {
      "type": "string",
      "enum": [
        "ork",
        "rasp",
        "glb",
        "stl",
        "csv"
      ]
    }
  }
}
