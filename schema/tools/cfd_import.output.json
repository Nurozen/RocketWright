{
  "type": "object",
  "properties": {
    "step": {
      "type": [
        "string",
        "null"
      ],
      "description": "Recorded step (`None` for dry runs and edits that change nothing, D3)."
    },
    "model_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dry_run": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FileChange"
      }
    },
    "delta": {
      "$ref": "#/$defs/CheckDelta"
    },
    "dataset": {
      "$ref": "#/$defs/CfdDataset"
    }
  },
  "required": [
    "model_hash",
    "dry_run",
    "files",
    "delta",
    "dataset"
  ],
  "description": "Output of every mutating tool (S:86).",
  "title": "CfdImportOut",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketwright.dev/schema/1/tools/cfd_import.output.json",
  "$defs": {
    "FileChange": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/FileStatus"
        }
      },
      "required": [
        "path",
        "status"
      ]
    },
    "FileStatus": {
      "type": "string",
      "enum": [
        "A",
        "M",
        "D"
      ]
    },
    "CheckDelta": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/CheckStatus"
        },
        "model_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "step": {
          "type": [
            "string",
            "null"
          ],
          "description": "The history step this mutation recorded; `None` for dry runs and no-op edits."
        },
        "changed": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Metric path → `[before, after]` (SI); `null` when absent on one side."
        },
        "new_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "resolved_diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "`<code>@<path>` keys of diagnostics that went away."
        }
      },
      "required": [
        "status",
        "model_hash",
        "changed",
        "new_diagnostics",
        "resolved_diagnostics"
      ],
      "description": "The post-edit check delta every mutating tool returns (S:86, I6; DA:118-123):\n\n```json\n{\"status\":\"warnings\",\"model_hash\":\"…\",\"step\":\"s0004\",\n \"changed\":{\"stability.liftoff\":[1.42,1.18],\"mass.liftoff\":[0.512,0.498]},\n \"new_diagnostics\":[{\"code\":\"RW-E101\",\"severity\":\"error\",\"path\":\"/c/fins/span\",\"message\":\"…\",\"hint\":\"…\"}],\n \"resolved_diagnostics\":[\"RW-W012@/c/body\"]}\n```"
    },
    "CheckStatus": {
      "type": "string",
      "enum": [
        "errors",
        "warnings",
        "clean"
      ],
      "description": "Overall status: `errors` if any error diagnostic or failed error-severity\nassertion, else `warnings` if any warning, else `clean`."
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Stable code, e.g. `RW-E021`.",
          "pattern": "^RW-[EWI][0-9]{3}$"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "JSON pointer into the source model, e.g. `/c/fins/span`."
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "description": "Project-relative file."
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "col": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ],
          "description": "Next action for an agent."
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "description": "One finding, phrased for an agent (`hint` says what to do next)."
    },
    "Severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "CfdDataset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sim": {
          "type": "string",
          "description": "Run directory under `runs/` (`cfd.<id>`)."
        },
        "run_id": {
          "type": "string",
          "description": "First 12 hex of blake3 over the source files' hashes (I7); the\nrecord is `runs/<sim>/<run_id>/cfd.json`.",
          "pattern": "^[0-9a-f]{12}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Source files, project-relative when inside the project, by time."
        },
        "times": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "x-unit-dimension": "time"
        },
        "scalars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScalarRange"
          }
        },
        "has_velocity": {
          "type": "boolean"
        },
        "point_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "Points over all steps."
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "description": "Always `cfd` (I13)."
        }
      },
      "required": [
        "id",
        "sim",
        "run_id",
        "files",
        "times",
        "scalars",
        "has_velocity",
        "point_count",
        "provenance"
      ]
    },
    "ScalarRange": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "min": {
          "type": "number",
          "format": "double"
        },
        "max": {
          "type": "number",
          "format": "double"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "Unit from the `# rw-cfd: units=` line, as written (`Pa`, `K`)."
        }
      },
      "required": [
        "name",
        "min",
        "max"
      ],
      "description": "One scalar column's range over every point of the dataset's steps."
    },
    "Provenance": {
      "type": "string",
      "enum": [
        "engineering",
        "visual",
        "cfd"
      ],
      "description": "Result provenance (I13). Visual results never feed engineering numbers."
    }
  }
}
