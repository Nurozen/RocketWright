{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "rw/1"
    },
    "status": {
      "$ref": "#/$defs/CheckStatus"
    },
    "tier": {
      "$ref": "#/$defs/CheckTier"
    },
    "model_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config": {
      "type": [
        "string",
        "null"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      }
    },
    "dims": {
      "$ref": "#/$defs/Dims"
    },
    "mass": {
      "$ref": "#/$defs/MassReport"
    },
    "aero": {
      "$ref": "#/$defs/AeroReport"
    },
    "stability": {
      "$ref": "#/$defs/StabilityReport"
    },
    "motor": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MotorReport"
      }
    },
    "interference": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Interference"
      }
    },
    "clearance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Clearance"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AssertionResult"
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ReportValue"
      },
      "description": "`[report]` values by expression."
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Project-relative file (and `motor:<ref>`) → content hash."
    },
    "sim": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunSummary"
        },
        {
          "type": "null"
        }
      ],
      "description": "Present with `--sim quick`."
    }
  },
  "required": [
    "schema",
    "status",
    "tier",
    "model_hash",
    "diagnostics",
    "dims",
    "mass",
    "aero",
    "stability",
    "motor",
    "interference",
    "clearance",
    "assertions",
    "report",
    "inputs"
  ],
  "description": "The `rw check --json` report (`design_check`, `rw://project/check`).",
  "title": "CheckReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketwright.dev/schema/1/check-report.json",
  "$defs": {
    "CheckStatus": {
      "type": "string",
      "enum": [
        "errors",
        "warnings",
        "clean"
      ],
      "description": "Overall status: `errors` if any error diagnostic or failed error-severity\nassertion, else `warnings` if any warning, else `clean`."
    },
    "CheckTier": {
      "type": "string",
      "enum": [
        "static",
        "quick_sim"
      ]
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Stable code, e.g. `RW-E021`.",
          "pattern": "^RW-[EWI][0-9]{3}$"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "JSON pointer into the source model, e.g. `/c/fins/span`."
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "description": "Project-relative file."
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "col": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ],
          "description": "Next action for an agent."
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "description": "One finding, phrased for an agent (`hint` says what to do next)."
    },
    "Severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "Dims": {
      "type": "object",
      "properties": {
        "length": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "length"
        },
        "max_diameter": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "length"
        },
        "fin_span": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "description": "Fin span tip to tip, if any fins.",
          "x-unit-dimension": "length"
        },
        "length_cal": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "description": "Overall length in calibers of the reference diameter\n(`stability.ref_diameter`); absent without a reference diameter."
        },
        "fineness": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "description": "Fineness ratio: overall length over the maximum body diameter; absent\nwithout a diameter."
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentDims"
          }
        }
      },
      "required": [
        "length",
        "max_diameter",
        "components"
      ]
    },
    "ComponentDims": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string"
        },
        "x_fore": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "length"
        },
        "x_aft": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "length"
        },
        "length": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "length"
        },
        "od": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "x-unit-dimension": "length"
        },
        "id": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "x-unit-dimension": "length"
        }
      },
      "required": [
        "component",
        "x_fore",
        "x_aft",
        "length"
      ]
    },
    "MassReport": {
      "type": "object",
      "properties": {
        "dry": {
          "type": "number",
          "format": "double",
          "description": "Without motors.",
          "x-unit-dimension": "mass"
        },
        "liftoff": {
          "type": "number",
          "format": "double",
          "description": "With loaded motors (launch mass).",
          "x-unit-dimension": "mass"
        },
        "burnout": {
          "type": "number",
          "format": "double",
          "description": "After all motors burn out.",
          "x-unit-dimension": "mass"
        },
        "propellant": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "mass"
        },
        "cg": {
          "type": "number",
          "format": "double",
          "description": "CG station at liftoff (oracle `cg_m`).",
          "x-unit-dimension": "length"
        },
        "cg_burnout": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "length"
        },
        "ixx": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "inertia"
        },
        "iyy": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "inertia"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentMassRow"
          },
          "description": "The mass breakdown: each component's dry mass and CG station, in tree\norder (metric paths `mass.components.<id>.mass`, `.cg`)."
        }
      },
      "required": [
        "dry",
        "liftoff",
        "burnout",
        "propellant",
        "cg",
        "cg_burnout",
        "ixx",
        "iyy",
        "components"
      ]
    },
    "ComponentMassRow": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string"
        },
        "mass": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "mass"
        },
        "cg": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "length"
        },
        "override": {
          "type": "boolean"
        }
      },
      "required": [
        "component",
        "mass",
        "cg",
        "override"
      ]
    },
    "AeroReport": {
      "type": "object",
      "properties": {
        "cp": {
          "type": "number",
          "format": "double",
          "description": "CP station at `mach` and AoA 0 (oracle `cp_m`).",
          "x-unit-dimension": "length"
        },
        "cna": {
          "type": "number",
          "format": "double",
          "description": "Normal-force slope per radian (oracle `cna`)."
        },
        "mach": {
          "type": "number",
          "format": "double"
        },
        "alpha": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "angle"
        },
        "cd": {
          "type": "number",
          "format": "double",
          "description": "Zero-AoA drag coefficient at `mach`."
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AeroTerm"
          },
          "description": "Per-component aero terms: each component's normal-force slope and CP\nstation, with its cited model (metric paths `aero.terms.<id>.cna`,\n`.cp`). At AoA 0, `cna` is the sum of the terms' `cna` and `cp` their\nCNa-weighted station."
        }
      },
      "required": [
        "cp",
        "cna",
        "mach",
        "alpha",
        "cd",
        "terms"
      ]
    },
    "AeroTerm": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string"
        },
        "cna": {
          "type": "number",
          "format": "double"
        },
        "cp": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "length"
        },
        "model": {
          "type": "string",
          "description": "Cited model id."
        }
      },
      "required": [
        "component",
        "cna",
        "cp",
        "model"
      ]
    },
    "StabilityReport": {
      "type": "object",
      "properties": {
        "liftoff": {
          "type": "number",
          "format": "double",
          "description": "Margin at liftoff in calibers (oracle `stability_cal`)."
        },
        "burnout": {
          "type": "number",
          "format": "double"
        },
        "min": {
          "type": "number",
          "format": "double",
          "description": "Minimum over the burn."
        },
        "liftoff_pct_length": {
          "type": "number",
          "format": "double",
          "description": "Liftoff margin as a percent of overall length."
        },
        "ref_diameter": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "length"
        }
      },
      "required": [
        "liftoff",
        "burnout",
        "min",
        "liftoff_pct_length",
        "ref_diameter"
      ]
    },
    "MotorReport": {
      "type": "object",
      "properties": {
        "mount": {
          "type": "string"
        },
        "designation": {
          "type": "string"
        },
        "total_impulse": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "impulse"
        },
        "burn_time": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "time"
        },
        "thrust_to_weight": {
          "type": "number",
          "format": "double"
        },
        "fits_mount": {
          "type": "boolean"
        },
        "retained": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "motor": {
          "type": "string",
          "description": "Motor ref as configured."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "mount",
        "designation",
        "total_impulse",
        "burn_time",
        "thrust_to_weight",
        "fits_mount",
        "motor",
        "sha256"
      ]
    },
    "Interference": {
      "type": "object",
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/InterferenceKind"
        },
        "depth": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "length"
        },
        "station": {
          "type": "number",
          "format": "double",
          "x-unit-dimension": "length"
        }
      },
      "required": [
        "a",
        "b",
        "kind",
        "depth",
        "station"
      ]
    },
    "InterferenceKind": {
      "type": "string",
      "enum": [
        "overlap",
        "protrusion",
        "fin_through_joint"
      ]
    },
    "Clearance": {
      "type": "object",
      "properties": {
        "rule": {
          "$ref": "#/$defs/ClearanceRule"
        },
        "a": {
          "type": "string"
        },
        "b": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "number",
          "format": "double",
          "description": "Required and actual value in SI of `dim`."
        },
        "actual": {
          "type": "number",
          "format": "double"
        },
        "dim": {
          "$ref": "#/$defs/DimKind"
        },
        "pass": {
          "type": "boolean"
        }
      },
      "required": [
        "rule",
        "a",
        "required",
        "actual",
        "dim",
        "pass"
      ]
    },
    "ClearanceRule": {
      "type": "string",
      "enum": [
        "coupler_fit",
        "motor_fit",
        "fin_tab_wall",
        "fin_across_joint",
        "recovery_volume",
        "rail_button_alignment",
        "centering_ring_fit"
      ]
    },
    "DimKind": {
      "oneOf": [
        {
          "type": "string",
          "const": "dimensionless",
          "description": "Pure number (ratios, counts, coefficients). Bare numbers allowed."
        },
        {
          "type": "string",
          "const": "length",
          "description": "m"
        },
        {
          "type": "string",
          "const": "mass",
          "description": "kg"
        },
        {
          "type": "string",
          "const": "time",
          "description": "s"
        },
        {
          "type": "string",
          "const": "temperature",
          "description": "K"
        },
        {
          "type": "string",
          "const": "angle",
          "description": "rad"
        },
        {
          "type": "string",
          "const": "area",
          "description": "m^2"
        },
        {
          "type": "string",
          "const": "volume",
          "description": "m^3"
        },
        {
          "type": "string",
          "const": "velocity",
          "description": "m/s"
        },
        {
          "type": "string",
          "const": "acceleration",
          "description": "m/s^2"
        },
        {
          "type": "string",
          "const": "force",
          "description": "N"
        },
        {
          "type": "string",
          "const": "pressure",
          "description": "Pa"
        },
        {
          "type": "string",
          "const": "density",
          "description": "kg/m^3"
        },
        {
          "type": "string",
          "const": "area_density",
          "description": "kg/m^2"
        },
        {
          "type": "string",
          "const": "line_density",
          "description": "kg/m"
        },
        {
          "type": "string",
          "const": "impulse",
          "description": "N*s"
        },
        {
          "type": "string",
          "const": "mass_flow",
          "description": "kg/s"
        },
        {
          "type": "string",
          "const": "angular_velocity",
          "description": "rad/s"
        },
        {
          "type": "string",
          "const": "inertia",
          "description": "kg*m^2"
        },
        {
          "type": "string",
          "const": "energy",
          "description": "J"
        },
        {
          "type": "string",
          "const": "power",
          "description": "W"
        },
        {
          "type": "string",
          "const": "frequency",
          "description": "1/s"
        },
        {
          "type": "string",
          "const": "torque",
          "description": "N*m"
        },
        {
          "type": "string",
          "const": "kinematic_viscosity",
          "description": "m^2/s (kinematic viscosity)"
        },
        {
          "type": "string",
          "const": "dynamic_viscosity",
          "description": "Pa*s"
        },
        {
          "type": "string",
          "const": "specific_heat",
          "description": "J/(kg*K)"
        }
      ],
      "description": "A named physical dimension, as written in `x-unit-dimension`."
    },
    "AssertionResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "expr": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "description": "Evaluated left-hand value (SI); `None` when it needs `--sim` or failed."
        },
        "pass": {
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "needs_sim": {
          "type": "boolean"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "expr",
        "pass",
        "severity",
        "needs_sim"
      ]
    },
    "ReportValue": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "format": "double"
        },
        "dim": {
          "$ref": "#/$defs/DimKind"
        }
      },
      "required": [
        "value",
        "dim"
      ]
    },
    "RunSummary": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "rw/1"
        },
        "apogee_m": {
          "type": "number",
          "format": "double"
        },
        "max_velocity_ms": {
          "type": "number",
          "format": "double"
        },
        "max_accel_ms2": {
          "type": "number",
          "format": "double"
        },
        "max_mach": {
          "type": "number",
          "format": "double"
        },
        "time_to_apogee_s": {
          "type": "number",
          "format": "double"
        },
        "flight_time_s": {
          "type": "number",
          "format": "double"
        },
        "landing_velocity_ms": {
          "type": "number",
          "format": "double"
        },
        "rail_exit_velocity_ms": {
          "type": "number",
          "format": "double"
        },
        "deployment_velocity_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "description": "Speed at the last recovery deployment (the main of a dual deploy)."
        },
        "optimum_delay_s": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min_stability_cal": {
          "type": "number",
          "format": "double",
          "description": "Minimum stability margin in flight (calibers), rail exit to apogee."
        },
        "burnout_time_s": {
          "type": "number",
          "format": "double"
        },
        "burnout_altitude_m": {
          "type": "number",
          "format": "double"
        },
        "landing_x_m": {
          "type": "number",
          "format": "double"
        },
        "landing_y_m": {
          "type": "number",
          "format": "double"
        },
        "drift_m": {
          "type": "number",
          "format": "double"
        },
        "coast_time_s": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "description": "Coast from the last burnout to apogee (apogee time minus last burnout\ntime; the same number as `optimum_delay_s`). Absent with no burnout\nbefore apogee."
        },
        "deployments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeploymentTiming"
          },
          "description": "Derived timing of each recovery deployment of the main flight, in time\norder (so agents never subtract event times by hand)."
        },
        "ejections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EjectionTiming"
          },
          "description": "Derived timing of each motor's ejection charge (motors with a\nconfigured delay), by mount id."
        }
      },
      "required": [
        "schema",
        "apogee_m",
        "max_velocity_ms",
        "max_accel_ms2",
        "max_mach",
        "time_to_apogee_s",
        "flight_time_s",
        "landing_velocity_ms",
        "rail_exit_velocity_ms",
        "min_stability_cal",
        "burnout_time_s",
        "burnout_altitude_m",
        "landing_x_m",
        "landing_y_m",
        "drift_m"
      ],
      "description": "`summary.json`. Key-sorted, fixed significant figures (I8). Absent values\n(no deployment, no delay) are omitted."
    },
    "DeploymentTiming": {
      "type": "object",
      "properties": {
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/RwRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The deployed device (rw:c/<id>)."
        },
        "t_s": {
          "type": "number",
          "format": "double",
          "description": "Deployment time after ignition.",
          "x-unit-dimension": "time"
        },
        "deploy_minus_apogee_s": {
          "type": "number",
          "format": "double",
          "description": "Deployment time minus apogee time: negative = before apogee.",
          "x-unit-dimension": "time"
        },
        "deploy_altitude_m": {
          "type": "number",
          "format": "double",
          "description": "Altitude above the launch site at deployment.",
          "x-unit-dimension": "length"
        },
        "deploy_velocity_ms": {
          "type": "number",
          "format": "double",
          "description": "Speed at deployment.",
          "x-unit-dimension": "velocity"
        }
      },
      "required": [
        "t_s",
        "deploy_minus_apogee_s",
        "deploy_altitude_m",
        "deploy_velocity_ms"
      ],
      "description": "One recovery deployment, relative to apogee."
    },
    "RwRef": {
      "type": "string",
      "description": "An rw: ref string (rw:c/fins).",
      "pattern": "^rw:(c|cfg|sim|run|step|rev|thread|eng)/[A-Za-z0-9_.-]+(#[A-Za-z0-9_<>]+)?(@[A-Za-z0-9_.:-]+)?(/[^\\s]*)?$"
    },
    "EjectionTiming": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/RwRef",
          "description": "The motor mount (rw:c/<mount>)."
        },
        "t_s": {
          "type": "number",
          "format": "double",
          "description": "Ejection time after ignition (the motor's burnout plus its delay).",
          "x-unit-dimension": "time"
        },
        "delay_s": {
          "type": "number",
          "format": "double",
          "description": "The configured ejection delay.",
          "x-unit-dimension": "time"
        },
        "optimum_delay_s": {
          "type": "number",
          "format": "double",
          "description": "Apogee time minus this motor's burnout time.",
          "x-unit-dimension": "time"
        },
        "delay_minus_optimum_s": {
          "type": "number",
          "format": "double",
          "description": "Configured delay minus optimum delay (= ejection time minus apogee\ntime): negative = the charge fires before apogee.",
          "x-unit-dimension": "time"
        }
      },
      "required": [
        "source",
        "t_s",
        "delay_s",
        "optimum_delay_s",
        "delay_minus_optimum_s"
      ],
      "description": "One motor's ejection charge against its optimum delay."
    }
  }
}
